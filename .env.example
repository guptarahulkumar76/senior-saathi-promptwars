# ====================================================================
# Senior Saathi - Environment Configuration
# ====================================================================

# Google Gemini API Key (keep this server-side only; never expose in frontend)
# If left empty, Senior Saathi will automatically run in high-fidelity Demo Mode!
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model
# Default: gemini-2.5-flash
# Alternative options: gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
